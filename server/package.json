{
  "name": "barbershop-server",
  "version": "0.1.0",
  "private": true,
  "description": "Barber Salon Management System — REST API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx --env-file=.env scripts/db-setup.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts latest",
    "db:rollback": "tsx --env-file=.env src/db/migrate.ts down",
    "staff:create-manager": "tsx --env-file=.env scripts/create-manager.ts",
    "db:seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.7",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

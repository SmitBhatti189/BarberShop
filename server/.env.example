# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# 0.0.0.0 lets phones/PCs on the salon LAN reach the API; use 127.0.0.1 to keep it local-only.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Comma-separated origins, or * during LAN testing.
CORS_ORIGINS=*

# Only used by `npm run db:setup` to create the app role and databases.
PG_SUPERUSER_PASSWORD=change-me

DATABASE_URL=postgres://barbershop_app:change-me@localhost:5432/barbershop
TEST_DATABASE_URL=postgres://barbershop_app:change-me@localhost:5432/barbershop_test

# At least 32 random characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Used by npm run staff:create-manager
MANAGER_USERNAME=owner
MANAGER_PASSWORD=change-me-min-8-chars
MANAGER_NAME=Salon Owner
